VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
VITE_IMAGEKIT_UPLOAD_ENABLED=false

# Supabase (browser-safe public keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service_role secret or the sb_secret_* key in the browser app.
# Keep those only in server-side code or Supabase Edge Functions.
